# Harpa Gaming — Environment Variables Example
# Copy this file to .env and configure for your local/production environment
# Do NOT commit the actual .env file to source control.

# ─── Public Variables (Vite Built) ─────────────────
VITE_SITE_URL=https://your-netlify-domain.netlify.app
VITE_API_URL=/api

# ─── Secret Variables (Backend / Build only) ───────
# Define any secrets needed for form handling, analytics, or APIs below.
# Example: 
# SMTP_PASSWORD=your_secure_app_password
# API_SECRET_KEY=your_secret_key

# ─── Brevo (Sendinblue) Newsletter ─────────────────
# Required: Get your API key from https://app.brevo.com/settings/keys/api
BREVO_API_KEY=your_brevo_api_key

# Brevo contact list ID for the waitlist (find in Brevo → Contacts → Lists)
BREVO_LIST_ID=2

# Email address to receive signup notifications
NOTIFICATION_EMAIL=info@harpagaming.com

# Brevo verified sender (must be verified in Brevo → Senders)
BREVO_SENDER_EMAIL=cronereal@gmail.com
BREVO_SENDER_NAME=HARPA Gaming
